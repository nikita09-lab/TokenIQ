# TokenIQ Backend Production & Staging Environment Configuration

# Application Environment (production / development / test)
ENVIRONMENT=production

# Server Binding (0.0.0.0 for cloud container/host binding)
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Frontend Production CORS Allowed Origins (comma-separated, NO trailing slashes)
CORS_ORIGINS=https://token-iq.vercel.app,https://token-iq-git-main-nikita-santosh-mishras-projects.vercel.app,https://token-rdmzzyx38-nikita-santosh-mishras-projects.vercel.app

# Primary Frontend URL
FRONTEND_URL=https://token-iq.vercel.app

# Delta Exchange India Testnet Endpoints (Testnet ONLY - Production strictly rejected by guard)
DELTA_TESTNET_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_API_URL=https://cdn-ind.testnet.deltaex.org
DELTA_WS_URL=wss://public-socket.india.delta.exchange

# Delta Exchange Testnet API Credentials (NEVER commit actual production/testnet keys)
DELTA_API_KEY=your_delta_testnet_api_key_here
DELTA_API_SECRET=your_delta_testnet_api_secret_here

# Request & Cache Configuration
REQUEST_TIMEOUT_SECONDS=15
TICKER_CACHE_TTL_SECONDS=2
