# TokenIQ Backend Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Delta Exchange Endpoints (India Testnet: https://cdn-ind.testnet.deltaex.org)
DELTA_API_URL=https://cdn-ind.testnet.deltaex.org
DELTA_WS_URL=wss://socket-ind-pub.testnet.deltaex.org

# Delta Exchange API Authentication (Demo / Testnet API key)
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# Frontend CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Rate Limiting & Timeouts
REQUEST_TIMEOUT_SECONDS=15
TICKER_CACHE_TTL_SECONDS=2
