# TokenIQ Backend Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Delta Exchange Public Endpoints (India Exchange)
DELTA_API_URL=https://api.india.delta.exchange/v2
DELTA_WS_URL=wss://public-socket.india.delta.exchange

# Frontend CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Rate Limiting & Timeouts
REQUEST_TIMEOUT_SECONDS=15
TICKER_CACHE_TTL_SECONDS=2


DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_BASE_URL=

