# TokenIQ Frontend Environment Configuration (Vercel & Local)

# Production Backend Base URL (Configure in Vercel Project Settings > Environment Variables)
# Replace placeholder with your real HTTPS backend domain once deployed (e.g., https://tokeniq-backend.onrender.com)
# In local development, leave this unset to use Vite's built-in dev proxy to http://127.0.0.1:8000
VITE_API_BASE_URL=https://YOUR-BACKEND-DOMAIN

# Optional: Production WebSocket URL override
# If omitted, it will automatically be derived from VITE_API_BASE_URL (converting https:// to wss://)
VITE_WS_URL=wss://YOUR-BACKEND-DOMAIN/api/v1/market/ws
